{
  "name": "teatime",
  "version": "1.0.0",
  "private": true,
  "description": "Personalized content, community, news, and AI assistance",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "start": "npm run start --workspace backend",
    "build": "npm run build --workspace frontend",
    "test": "npm run test --workspace backend",
    "db:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema backend/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema backend/prisma/schema.prisma",
    "db:seed": "node backend/scripts/seed/index.js",
    "db:import-mongo": "node backend/scripts/migrateMongoToPostgres.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.0"
  }
}
